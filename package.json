{
  "name": "scalabel",
  "version": "0.3.0",
  "bin": "./app/dist/main.js",
  "files": [
    "app/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/scalabel/scalabel"
  },
  "license": "Apache-2.0",
  "homepage": "https://www.scalabel.ai",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "webpack --config webpack.config.js --mode=production",
    "watch-dev": "webpack --watch --config webpack.config.js --mode=development",
    "serve": "node --max-old-space-size=8192 app/dist/main.js --config ./local-data/scalabel/config.yml",
    "lint": "eslint -c .eslintrc.json --ext .ts,.tsx app/src/ app/test",
    "test": "jest"
  },
  "jest": {
    "collectCoverage": true,
    "collectCoverageFrom": [
      "app/src/**/*.{ts,tsx}"
    ],
    "globalSetup": "./app/test/setup/global_setup.ts",
    "setupFiles": [
      "./app/test/setup/local_setup.ts"
    ],
    "setupFilesAfterEnv": [
      "./app/test/setup/setup_jest_after_env.ts",
      "jest-expect-message"
    ],
    "globalTeardown": "./app/test/setup/global_teardown.ts",
    "roots": [
      "app/test"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ],
      "\\.js?$": "babel-jest"
    },
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "\\.(css|less)$": "identity-obj-proxy",
      "^@img/sharp-(.*)/sharp\\.node$": "<rootDir>/node_modules/@img/sharp-$1/index.cjs",
      "^@img/sharp-(.*)/(package|versions)$": "<rootDir>/node_modules/@img/sharp-$1/$2.json"
    },
    "testEnvironmentOptions": {
      "url": "http://localhost:8687",
      "customExportConditions": [
        "node",
        "node-addons"
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(formidable)/)"
    ]
  },
  "husky": {
    "hooks": {}
  },
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-react"
    ]
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/credential-providers": "^3.900.0",
    "@babel/cli": "^7.13.16",
    "@babel/core": "^7.17.10",
    "@babel/eslint-parser": "^7.18.9",
    "@babel/node": "^7.13.13",
    "@babel/preset-env": "^7.17.10",
    "@babel/preset-react": "^7.13.13",
    "@emotion/react": "^11.5.0",
    "@emotion/styled": "^11.3.0",
    "@fingerprintjs/fingerprintjs": "^3.1.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "@mapbox/node-pre-gyp": "^2.0.3",
    "@material-ui/core": "^4.12.3",
    "@material-ui/icons": "^4.11.2",
    "@material-ui/lab": "^4.0.0-alpha.58",
    "@material-ui/styles": "^4.11.4",
    "@mui/material": "^5.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^12.1.5",
    "@types/amazon-cognito-auth-js": "^1.2.2",
    "@types/blueimp-md5": "^2.18.0",
    "@types/express": "^4.17.23",
    "@types/express-jwt": "^7.4.4",
    "@types/formidable": "^3.4.5",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/jest-expect-message": "^1.1.0",
    "@types/js-yaml": "^4.0.1",
    "@types/lodash": "^4.14.168",
    "@types/material-ui": "^0.21.8",
    "@types/mock-fs": "^4.13.4",
    "@types/node": "^20.19.0",
    "@types/orderedmap": "^2.0.0",
    "@types/react": "^17.0.4",
    "@types/react-dom": "^17.0.3",
    "@types/react-redux": "^7.1.16",
    "@types/react-test-renderer": "^17.0.1",
    "@types/redis": "^4.0.11",
    "@types/redux-logger": "^3.0.8",
    "@types/socket.io": "^3.0.2",
    "@types/socket.io-client": "^3.0.0",
    "@types/supertest": "^6.0.3",
    "@types/three": "^0.127.1",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^5.33.1",
    "@typescript-eslint/parser": "^5.33.1",
    "amazon-cognito-auth-js": "^1.3.3",
    "axios": "^1.20.0",
    "babel-jest": "^30.5.1",
    "babel-loader": "^10.1.1",
    "blueimp-md5": "^2.19.0",
    "body-parser": "^1.20.6",
    "canvas": "^3.2.3",
